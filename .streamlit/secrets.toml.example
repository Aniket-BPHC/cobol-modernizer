# .streamlit/secrets.toml.example
# Copy this to .streamlit/secrets.toml for local use.
# For hosted deployments, set these in the platform's Secrets UI — never commit the real file.

OPENAI_API_KEY = "sk-..."

# Optional: HuggingFace Hub repos for SLM adapters (set after training + pushing)
